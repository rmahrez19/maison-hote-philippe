# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Clé publique (anon/publishable) — utilisée UNIQUEMENT pour l'authentification
# admin (login, MFA), jamais pour les données métier (qui passent par
# SUPABASE_SERVICE_ROLE_KEY côté serveur). Sans policy RLS publique, cette
# clé ne peut lire ni écrire aucune donnée de réservation.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# URLs des calendriers iCal exportés par Booking.com — une par chambre,
# chaque chambre étant listée séparément sur Booking.com.
# (Extranet Booking > Calendrier > Synchroniser les calendriers > Exporter)
BOOKING_ICAL_URL_RIVE_GAUCHE=https://ical.booking.com/v1/export?t=xxxxxxxx
BOOKING_ICAL_URL_RIVE_DROITE=https://ical.booking.com/v1/export?t=yyyyyyyy

# Numéro de contact affiché sur /reservation-contact (appel, SMS, WhatsApp),
# tant que la réservation en ligne n'est pas ouverte. Format international
# E.164, sans espace : 06 12 34 56 78 -> +33612345678.
# Si absent, la valeur par défaut de lib/contact.ts est utilisée.
NEXT_PUBLIC_CONTACT_PHONE=+33612345678

# Itération suivante : notifications
# RESEND_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
